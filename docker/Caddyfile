{
    email {$ACME_EMAIL}
    on_demand_tls {
        ask http://api:3001/internal/domain-check
    }
}

# Main frontend
{$APP_DOMAIN} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    reverse_proxy web:3000
}

# REST API
api.{$APP_DOMAIN} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    reverse_proxy api:3001
}

# WebSocket server
ws.{$APP_DOMAIN} {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    reverse_proxy ws:3002
}

# On-demand TLS handles both *.app.{$APP_DOMAIN} subdomains and custom domains.
# Wildcard certs require DNS-01 which Caddy can't do here; on-demand issues
# per-subdomain certs via HTTP-01 instead.
:443 {
    tls {
        on_demand
    }
    # Caddy automatically handles X-Forwarded-* headers perfectly
    reverse_proxy api:3001
}