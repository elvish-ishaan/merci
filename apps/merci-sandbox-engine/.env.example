# Secret shared with the API service (must match SANDBOX_ENGINE_SECRET in api .env)
SANDBOX_ENGINE_SECRET="change-this-to-a-long-random-secret"

# Docker image to use for sandbox execution
# oven/bun:alpine runs both .js and .ts natively — no custom image needed
SANDBOX_IMAGE="oven/bun:alpine"

# Port to listen on
PORT="3003"
