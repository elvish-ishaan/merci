DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mercy"

# Must match apps/api/.env and apps/merci-actions/.env
ENV_ENCRYPTION_KEY="your-64-char-hex-key-here"

# Must match apps/merci-actions/.env WORKER_SECRET
WORKER_SECRET="change-this-to-a-long-random-secret"

REDIS_HOST="localhost"
REDIS_PORT="6379"

# Internal URL of merci-actions (for posting logs and status updates)
MERCI_ACTIONS_INTERNAL_URL="http://localhost:3003"

# How many jobs to process in parallel (each job = one Docker container)
WORKER_CONCURRENCY="2"
