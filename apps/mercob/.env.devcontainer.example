DATABASE_URL="postgresql://postgres:postgres@postgres:5432/mercy"

REDIS_HOST="redis"
REDIS_PORT="6379"

# Must match WORKER_SECRET in apps/api/.env
WORKER_SECRET="change-this-to-a-long-random-secret"

# Base URL of apps/api — used to post job logs and patch run status
API_BASE_URL="http://localhost:3001"
