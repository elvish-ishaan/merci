DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mercy"

JWT_SECRET="change-this-to-a-long-random-secret"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the value in apps/worker/.env
ENV_ENCRYPTION_KEY="your-64-char-hex-key-here"

# Shared secret between merci-actions and action-worker for internal endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET="change-this-to-a-long-random-secret"

REDIS_HOST="localhost"
REDIS_PORT="6379"

# Public URL where GitHub will deliver webhook payloads
# Must be reachable from the internet (use ngrok in dev: ngrok http 3003)
MERCI_ACTIONS_URL="https://your-domain.com"

PORT="3003"
