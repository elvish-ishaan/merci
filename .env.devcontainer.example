# ══════════════════════════════════════════════════════════════════════════════
# mercy — devcontainer environment variables (all apps combined)
# ══════════════════════════════════════════════════════════════════════════════
#
# This is a convenience reference listing EVERY variable across all apps.
# The per-app .env.devcontainer.example files are what post-create.sh copies
# automatically on container creation.
#
# Inside the devcontainer, postgres and redis are reachable by their compose
# service names ('postgres', 'redis') — NOT 'localhost'.
#
# Shared secrets — must be IDENTICAL across all apps that use them:
#   JWT_SECRET        → apps/api, apps/ws
#   WORKER_SECRET     → apps/api, apps/worker, apps/mercob
#   ENV_ENCRYPTION_KEY → apps/api, apps/worker
#
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Infrastructure ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/mercy"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_URL="redis://redis:6379"

# ── Auth secrets ───────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret"
WORKER_SECRET="change-this-to-a-long-random-secret"
ENV_ENCRYPTION_KEY="your-64-char-hex-key-here"

# ── GitHub OAuth (apps/api) ────────────────────────────────────────────────────
# Create at https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3001/auth/github/callback"
FRONTEND_URL="http://localhost:3000"

# ── Cloudflare R2 (apps/api, apps/worker, apps/mercio-runtime) ─────────────────
# For local dev you can leave these blank — features that need R2 will fail.
# Alternatively, run a local MinIO container and point R2_ENDPOINT to it.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="merci"

# ── apps/api ───────────────────────────────────────────────────────────────────
BASE_DOMAIN="localhost"

# ── apps/web ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* are browser-facing — must use localhost (port-forwarded by VS Code)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3002"

# ── apps/ws ────────────────────────────────────────────────────────────────────
WS_PORT="3002"

# ── apps/worker + apps/mercob ──────────────────────────────────────────────────
API_BASE_URL="http://localhost:3001"

# ── apps/mercio-runtime ────────────────────────────────────────────────────────
MERCIO_CACHE_DIR="/tmp/mercio"
# MERCIO_POOL_MAX=20
# MERCIO_IDLE_TTL_MS=300000
# WORKERD_BIN=/usr/local/bin/workerd
